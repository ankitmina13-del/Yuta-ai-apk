<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Outer glow ring -->
    <path android:pathData="M54,20 A34,34 0 1,1 53.9,20 Z"
        android:strokeWidth="2"
        android:fillColor="#00000000">
        <aapt:attr xmlns:aapt="http://schemas.android.com/aapt" name="android:strokeColor">
            <gradient
                android:angle="45"
                android:startColor="#7C5CFF"
                android:endColor="#00E5C7"
                android:type="linear" />
        </aapt:attr>
    </path>

    <!-- Y mark: left diagonal -->
    <path android:pathData="M38,30 L54,56 L54,56 L46,56 L32,34 Z">
        <aapt:attr xmlns:aapt="http://schemas.android.com/aapt" name="android:fillColor">
            <gradient
                android:angle="90"
                android:startColor="#B9A6FF"
                android:endColor="#7C5CFF"
                android:type="linear" />
        </aapt:attr>
    </path>

    <!-- Y mark: right diagonal -->
    <path android:pathData="M70,30 L76,34 L62,56 L54,56 Z">
        <aapt:attr xmlns:aapt="http://schemas.android.com/aapt" name="android:fillColor">
            <gradient
                android:angle="90"
                android:startColor="#7FF5E6"
                android:endColor="#00E5C7"
                android:type="linear" />
        </aapt:attr>
    </path>

    <!-- Y mark: stem -->
    <path android:pathData="M50,56 L58,56 L58,80 L50,80 Z"
        android:fillColor="#F5F3FF" />

    <!-- Center spark dot -->
    <path android:pathData="M54,50 m-4,0 a4,4 0 1,1 8,0 a4,4 0 1,1 -8,0"
        android:fillColor="#FFFFFF" />
</vector>
